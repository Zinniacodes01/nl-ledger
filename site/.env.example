# Copy to site/.env (ignored by git) to deploy or sync the search index.
# Local builds (node build.mjs, ./check.sh) and the pipeline need neither value.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
NL_LEDGER_D1_ID=your-d1-database-id
# Optional: extra names site/check.sh must never find in the site (a regex).
NL_LEDGER_PRIVATE_NAMES=
